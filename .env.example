# Frontend
# Porta publicada do frontend (Nginx) no host
FRONTEND_PORT=5173
# Endereço da API usado pelo navegador; embutido no build do frontend
VITE_API_URL=http://localhost:8000

# Backend
BACKEND_PORT=8000
# Origens explícitas permitidas pelo CORS, separadas por vírgula (não use *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=c216
POSTGRES_USER=c216
POSTGRES_PASSWORD=c216
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://c216:c216@localhost:5432/c216
